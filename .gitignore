build/
build2/
build-*/
cmake-build-*/
out/

# Байткод Python, который CPython пишет рядом с python/bridge.py при
# первом импорте моста (см. src/crypto/python_bridge.cpp). Имя файла
# зависит от версии интерпретатора, так что на разных машинах он ещё и
# разный.
__pycache__/
*.pyc

*.o
*.obj

# Vendored third-party libraries' own TODO.md files (e.g. range-v3) - not
# ours, not meant to be tracked here. Our own TODO.md (repo root) is
# tracked deliberately.
/third_party/**/TODO.md
*.exe
*.dll
*.so
*.dylib

# TDLib session/db files — live account credentials, never commit
tdlib-db/
tdlib-files/
*.session
*.binlog
*.sqlite
*.sqlite-shm
*.sqlite-wal
data/

# Diagnostic log written next to zkgram.exe at runtime, not source
zkgram_debug.log

# Ad-hoc build logs (build-cmake.ps1 output redirected here during
# iteration, e.g. build_log63.txt) - not source, not meant to be committed.
build_log*.txt

.vs/
.vscode/
.idea/
.claude/
# Personal session logs/notes and machine-local Claude Code settings, split
# out of .claude/ so .claude/ itself (CLAUDE.md/UI.md - project convention,
# not personal) can be pushed later without also pushing this.
.private/
CMakeCache.txt
CMakeFiles/

# Full tdesktop clone kept locally as a style/UX reference (see TODO.md) -
# not our code, not meant to be committed into zkgram's own history.
telegram_fork/
build/Release/*.pdb
*.pdb

# Fetched by build.sh (see fetch_third_party): sources the vendored
# third_party/desktop-app expects in place but does not carry, cloned from
# upstream rather than committed here.
/third_party/desktop-app/cmake/external/glib/cppgir/
/third_party/desktop-app/ThirdParty/kcoreaddons/
/third_party/desktop-app/ThirdParty/xdg-desktop-portal/
